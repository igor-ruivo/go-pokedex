{
	"name": "go-pokedex",
	"version": "1.0.0",
	"type": "module",
	"homepage": "https://go-pokedex.com",
	"private": true,
	"scripts": {
		"dev": "vite --host --port 3000",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint:check": "eslint --ext .ts,.tsx,.mjs ./src ./scripts",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,js,json,css,md}\" \"scripts/**/*.mjs\" *.json *.md *.cjs",
		"format": "npx prettier --write \"src/**/*.{ts,tsx,js,json,css,md}\" \"scripts/**/*.mjs\" *.json *.md *.cjs",
		"prerender": "node scripts/prerender.mjs",
		"deploy": "pnpm run build && pnpm run prerender && node scripts/deploy.mjs",
		"deploy:quick": "vite build --no-emptyOutDir && node scripts/deploy.mjs",
		"lint": "npx eslint --fix --ext .ts,.tsx,.mjs ./src ./scripts ./eslint.config.cjs ./prettier.config.cjs ./package.json ./tsconfig.json ./index.html 2>&1 && pnpm run format && pnpm tsc --noEmit"
	},
	"dependencies": {
		"@tanstack/query-sync-storage-persister": "^5.102.8",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-query-persist-client": "^5.102.8",
		"@tanstack/react-virtual": "^3.14.11",
		"comlink": "^4.4.2",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-router-dom": "^7.7.0"
	},
	"devDependencies": {
		"@ti-platform/aide-build-tools": "^4.1.0",
		"@tsconfig/recommended": "^1.0.10",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@typescript-eslint/parser": "^8.37.0",
		"eslint": "^9.31.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-promise": "^7.2.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"gh-pages": "^6.3.0",
		"playwright": "^1.63.0",
		"prettier": "^3.6.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.37.0",
		"vite": "^7.0.5",
		"vitest": "^5.0.0"
	}
}
